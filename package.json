    "@neondatabase/serverless": "^1.0.2",
    "@vercel/analytics": "^1.6.1",
    "kysely": "^0.28.11",
    "next": "16.1.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "yahoo-finance2": "^3.13.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.6",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "kysely-codegen": "^0.19.0",
    "pg": "^8.18.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
